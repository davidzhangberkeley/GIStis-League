        function getColor(ai) {
            if (ai >= 90) return '#1a9850';
            if (ai >= 75) return '#91cf60';
            if (ai >= 60) return '#d9ef8b';
            if (ai >= 45) return '#fee08b';
            if (ai >= 30) return '#fc8d59';
            return '#d73027';
        }

        function getStyle(feature) {
            return {
                fillColor: getColor(feature.properties.accessibility_index),
                weight: 1.5,
                opacity: 0.9,
                color: '#fff',
                fillOpacity: 0.85
            };
        }

        function onEachFeature(feature, layer) {
            const props = feature.properties;
            
            const ttip = '<div style="font-weight: 600; font-size: 13px; margin-bottom: 6px;">' + props.name + '</div>' +
                '<div style="font-size: 11px; color: #666;">AI: <strong>' + props.accessibility_index + 
                '/100</strong><br>Income: $' + props.median_income.toLocaleString() + '<br>' + props.city + ', ' + props.county + '</div>';
            
            layer.bindTooltip(ttip, {
                permanent: false,
                direction: 'top',
                className: 'custom-tooltip',
                sticky: false
            });

            layer.on('click', function() {
                showTooltipPanel(props);
            });

            layer.on('mouseover', function() {
                this.setStyle({
                    weight: 3,
                    opacity: 1,
                    fillOpacity: 0.95
                });
                this.bringToFront();
            });

            layer.on('mouseout', function() {
                geojsonLayer.resetStyle(this);
            });
        }

        const geojsonLayer = L.geoJSON(tractData, {
            style: getStyle,
            onEachFeature: onEachFeature
        }).addTo(map);

        function updateStats() {
            const ais = tractData.features.map(f => f.properties.accessibility_index);
            const avgAI = (ais.reduce((a, b) => a + b, 0) / ais.length).toFixed(1);
            document.getElementById('avgAI').textContent = avgAI;
            document.getElementById('totalTracts').textContent = tractData.features.length;
        }

        function createColorScale() {
            const scale = document.getElementById('colorScale');
            const colors = [
                {color: '#d73027', label: '0'},
                {color: '#fc8d59', label: '20'},
                {color: '#fee08b', label: '40'},
                {color: '#d9ef8b', label: '60'},
                {color: '#91cf60', label: '80'},
                {color: '#1a9850', label: '100'}
            ];
            
            colors.forEach(item => {
                const bar = document.createElement('div');
                bar.className = 'color-bar';
                bar.style.backgroundColor = item.color;
                bar.textContent = item.label;
                scale.appendChild(bar);
            });
        }

        function showTooltipPanel(props) {
            document.getElementById('tooltipTitle').textContent = props.name;
            document.getElementById('tooltipGeoid').textContent = props.GEOID;
            document.getElementById('tooltipCity').textContent = props.city;
            document.getElementById('tooltipCounty').textContent = props.county;
            document.getElementById('tooltipIncome').textContent = props.median_income.toLocaleString();
            document.getElementById('tooltipHomeValue').textContent = props.median_home_value.toLocaleString();
            document.getElementById('tooltipAI').textContent = props.accessibility_index;
            
            const badge = document.getElementById('aiBadge');
            badge.style.backgroundColor = getColor(props.accessibility_index);
            
            document.getElementById('tooltipPanel').classList.add('active');
        }

        updateStats();
        createColorScale();

        setTimeout(() => {
            map.fitBounds(geojsonLayer.getBounds(), {padding: [50, 50]});
        }, 500);
