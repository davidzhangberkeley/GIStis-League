"""
Scikit-Learn ML Demo
------------------------
Trains a Random Forest classifier on the classic Iris dataset,
evaluates performance, and visualizes results.
"""

import numpy as np
import matplotlib.pyplot as plt
import matplotlib.gridspec as gridspec
from sklearn.datasets import load_iris
from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import (
    accuracy_score, classification_report, confusion_matrix, ConfusionMatrixDisplay
)
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA

# ── 1. Load Data ──────────────────────────────────────────────────────────────
iris = load_iris()
X, y = iris.data, iris.target
feature_names = iris.feature_names
class_names   = iris.target_names

print("=" * 55)
print("  🌸  Iris Dataset  ")
print("=" * 55)
print(f"  Samples    : {X.shape[0]}")
print(f"  Features   : {X.shape[1]}  → {feature_names}")
print(f"  Classes    : {list(class_names)}")

# ── 2. Split ──────────────────────────────────────────────────────────────────
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.25, random_state=42, stratify=y
)

# ── 3. Scale ──────────────────────────────────────────────────────────────────
scaler  = StandardScaler()
X_train = scaler.fit_transform(X_train)
X_test  = scaler.transform(X_test)

# ── 4. Train ──────────────────────────────────────────────────────────────────
model = RandomForestClassifier(n_estimators=100, random_state=42)
model.fit(X_train, y_train)

# ── 5. Evaluate ───────────────────────────────────────────────────────────────
y_pred   = model.predict(X_test)
accuracy = accuracy_score(y_test, y_pred)

print(f"\n  ✅ Test Accuracy : {accuracy * 100:.1f}%")
print("\n  Classification Report:\n")
print(classification_report(y_test, y_pred, target_names=class_names))

# ── 6. Visualise ──────────────────────────────────────────────────────────────
fig = plt.figure(figsize=(14, 5), facecolor="#0f0f1a")
gs  = gridspec.GridSpec(1, 3, figure=fig, wspace=0.35)

DARK  = "#0f0f1a"
PANEL = "#1a1a2e"
ACCENT= "#7c5cbf"
TEXT  = "#e0d7f5"
COLORS= ["#7c5cbf", "#5cb8bf", "#bf5c7c"]

plt.rcParams.update({"text.color": TEXT, "axes.labelcolor": TEXT,
                     "xtick.color": TEXT, "ytick.color": TEXT})

# -- a) Confusion Matrix
ax0 = fig.add_subplot(gs[0])
ax0.set_facecolor(PANEL)
cm  = confusion_matrix(y_test, y_pred)
im  = ax0.imshow(cm, cmap="Purples")
ax0.set_xticks(range(3)); ax0.set_yticks(range(3))
ax0.set_xticklabels(class_names, rotation=30, ha="right", fontsize=9)
ax0.set_yticklabels(class_names, fontsize=9)
for i in range(3):
    for j in range(3):
        ax0.text(j, i, str(cm[i, j]), ha="center", va="center",
                 color="white", fontweight="bold", fontsize=12)
ax0.set_title("Confusion Matrix", fontsize=11, pad=10, color=TEXT)
ax0.set_xlabel("Predicted", fontsize=9)
ax0.set_ylabel("Actual", fontsize=9)

# -- b) Feature Importances
ax1 = fig.add_subplot(gs[1])
ax1.set_facecolor(PANEL)
importances = model.feature_importances_
idx = np.argsort(importances)
bars = ax1.barh(
    [feature_names[i].replace(" (cm)", "") for i in idx],
    importances[idx],
    color=[COLORS[i % 3] for i in range(4)],
    edgecolor="none", height=0.5
)
ax1.set_title("Feature Importances", fontsize=11, pad=10, color=TEXT)
ax1.set_xlabel("Mean Decrease in Impurity", fontsize=9)
ax1.spines[:].set_visible(False)
ax1.grid(axis="x", color="white", alpha=0.1)

# -- c) PCA scatter
ax2 = fig.add_subplot(gs[2])
ax2.set_facecolor(PANEL)
pca    = PCA(n_components=2)
X_pca  = pca.fit_transform(scaler.transform(X))
for i, (cls, col) in enumerate(zip(class_names, COLORS)):
    mask = y == i
    ax2.scatter(X_pca[mask, 0], X_pca[mask, 1],
                label=cls, color=col, s=28, alpha=0.8, edgecolors="none")
ax2.set_title("PCA — 2D Projection", fontsize=11, pad=10, color=TEXT)
ax2.set_xlabel(f"PC1 ({pca.explained_variance_ratio_[0]*100:.1f}%)", fontsize=9)
ax2.set_ylabel(f"PC2 ({pca.explained_variance_ratio_[1]*100:.1f}%)", fontsize=9)
ax2.legend(fontsize=8, framealpha=0.3, facecolor=PANEL, edgecolor="none",
           labelcolor=TEXT)
ax2.spines[:].set_visible(False)
ax2.grid(color="white", alpha=0.08)

fig.suptitle(
    f"Random Forest on Iris  •  Accuracy: {accuracy*100:.1f}%",
    fontsize=13, color=TEXT, y=1.02, fontweight="bold"
)

out_path = "/mnt/user-data/outputs/sklearn_results.png"
plt.savefig(out_path, dpi=150, bbox_inches="tight", facecolor=DARK)
print(f"\n  📊 Plot saved → {out_path}")
print("=" * 55)
